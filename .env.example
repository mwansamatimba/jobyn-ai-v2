# Application
APP_NAME=Jobyn AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security - generate a real secret with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# PostgreSQL (production and docker-compose)
DATABASE_URL=postgresql+asyncpg://jobyn:jobyn@localhost:5432/jobyn
# SQLite fallback for local development without a database server:
# DATABASE_URL=sqlite+aiosqlite:///./jobyn.db

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_CONCURRENCY=4

# CORS
BACKEND_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
