# ==============================================================================
# Jobyn AI — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=Jobyn AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Security — generate a real secret with: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Database
# PostgreSQL (production and docker-compose)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jobyn:jobyn@localhost:5432/jobyn

# SQLite fallback for local development without a database server:
# DATABASE_URL=sqlite+aiosqlite:///./jobyn.db

# ------------------------------------------------------------------------------
# Redis and Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ==============================================================================
# LLM PROVIDER SELECTION
#
# LLM_PROVIDER controls which backend handles core AI workloads:
#   cv analysis, candidate profiles, job matching, career navigation,
#   and interview coaching.
#
# Cover-letter generation always uses TaBiAI/Claude (see below) and is
# unaffected by this setting.
#
# Supported values:
#   nvidia      — NVIDIA NIM via the OpenAI-compatible endpoint.
#                 Existing/default behaviour. Use in production.
#   freellmapi  — FreeLLMAPI self-hosted router. EXPERIMENTAL / demo only.
#                 Requires FREELLMAPI_BASE_URL and FREELLMAPI_API_KEY.
#
# Default: nvidia  (existing deployments are unaffected unless this is
#                   explicitly set to freellmapi)
# ==============================================================================
LLM_PROVIDER=nvidia


# ==============================================================================
# FREELLMAPI  (EXPERIMENTAL — demo / development only)
#
# IMPORTANT — DATA PRIVACY:
#   FreeLLMAPI routes prompts to upstream free-tier providers (Groq,
#   Cerebras, Google AI Studio, NVIDIA, Mistral, Cohere, etc.).
#   Candidate CV text and all other request payloads leave your
#   infrastructure and are subject to each upstream provider's own
#   data-retention and privacy policies.
#
#   DO NOT use FreeLLMAPI with real user data in production.
#   Reference: https://github.com/tashfeenahmed/freellmapi#disclaimer
#
# SETUP:
#   1. Install FreeLLMAPI locally:
#        curl -fsSL https://freellmapi.co/install.sh | bash
#      Or use the Windows .exe installer from:
#        https://github.com/tashfeenahmed/freellmapi/releases
#   2. Open the dashboard at http://localhost:3001
#   3. Add your provider API keys on the Keys page.
#   4. Copy the unified API key from the dashboard header.
#   5. Set FREELLMAPI_BASE_URL and FREELLMAPI_API_KEY below.
#   6. Set LLM_PROVIDER=freellmapi above.
#
# TO ROLL BACK TO NVIDIA:
#   Set LLM_PROVIDER=nvidia  (FreeLLMAPI settings are ignored).
# ==============================================================================

# Base URL of your self-hosted FreeLLMAPI instance.
# Required when LLM_PROVIDER=freellmapi.
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Unified bearer token from the FreeLLMAPI dashboard (format: freellmapi-…).
# Required when LLM_PROVIDER=freellmapi.
# NEVER commit a real key here.
FREELLMAPI_API_KEY=

# Routing strategy / model identifier passed to the FreeLLMAPI router.
#   auto        — FreeLLMAPI picks the best available provider (recommended).
#   auto:fast   — optimise for low latency.
#   auto:smart  — optimise for capability.
#   <model-id>  — specific model from https://freellmapi.co/models
FREELLMAPI_MODEL=auto


# ==============================================================================
# NVIDIA NIM  (primary provider when LLM_PROVIDER=nvidia)
#
# Keep these set even when LLM_PROVIDER=freellmapi so you can roll back
# instantly by changing a single variable.
# ==============================================================================

# NVIDIA NIM API key — obtain from https://build.nvidia.com
NVIDIA_API_KEY=

# NVIDIA NIM OpenAI-compatible endpoint (default shown; usually no change needed)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Primary model (Nemotron Lightning — structured JSON, reasoning support)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embedding model for semantic search / CV-job matching (optional)
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Nemotron thinking mode — set true to enable chain-of-thought reasoning.
# Leave false for structured JSON workloads (more reliable output).
NVIDIA_ENABLE_THINKING=false

# Reasoning token budget when NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=8192

# Nucleus sampling parameter (0 < top_p <= 1)
NVIDIA_TOP_P=0.95


# ==============================================================================
# TaBiAI / Claude — cover-letter generation
#
# Always active regardless of LLM_PROVIDER.
# Cover-letter generation uses TaBiAI's Claude endpoint independently.
# ==============================================================================

# TaBiAI bearer token — obtain from https://tabitoken.com
TABITOKEN_API_KEY=

TABITOKEN_BASE_URL=https://tabitoken.com/v1
TABITOKEN_COVER_LETTER_MODEL=claude-opus-5
TABITOKEN_TIMEOUT_SECONDS=60
TABITOKEN_FALLBACK_ENABLED=true


# ==============================================================================
# Google Gemini (legacy — currently disabled, no credits)
# ==============================================================================
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_SECONDS=60
